<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.asp" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <asp scriptErrorSentToBrowser="true"
         bufferingOn="true"
         enableParentPaths="false"
         enableApplicationRestart="true"
         enableClientSideInclude="true"
         enableServerSideInclude="true">
      <session allowSessionState="true" timeout="120" />
      <limits bufferingLimit="41943040"
              maxRequestEntityAllowed="26214400"
              scriptTimeout="300"
              processorThreadMax="25" />
    </asp>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="26214400" />
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".mdb" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
