<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!--50MB=50MB*1024KB*1024B-->
		<add key="maxSongLength" value="52428800"/>
		<add key="albumImagePath" value="~/albumImages/"/>
		<add key="artistImagePath" value="~/artistImages/"/>
		<add key="userPhotoPath" value="~/userImages/"/>
		<add key="songFolderPath" value="~/SongFiles/"/>
		<add key="playlistFolderPath" value="~/playlistImages/"/>
	</appSettings>
	<connectionStrings>
		<!-- SQL Server local (puerto 1433). Si usa el contenedor Docker del laboratorio, cambie a: Data Source=localhost,14333 -->
		<add name="BDD_PoliMusicConnectionString" connectionString="Data Source=localhost;Initial Catalog=BDD_PoliMusic;User ID=usr_polimusic;Password=Politecnica1" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<compilation debug="true"/>
		<customErrors mode="Off"/>
		<!--50MB to KB-->
		<httpRuntime maxRequestLength="51200"/>
		<authentication mode="Forms">
			<forms loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="20"/>
		</authentication>
		<authorization>
			<deny users="?"/>
		</authorization>
		<pages/>
	</system.web>
	<location path="SignUp.aspx">
		<system.web>
			<authorization>
				<allow users="*"/>
			</authorization>
		</system.web>
	</location>
	<location path="SongFiles">
		<system.web>
			<httpRuntime maxRequestLength="51200"/>
		</system.web>
	</location>
	<system.webServer>
		<security>
			<requestFiltering>
				<!-- 50MB en bytes -->
				<requestLimits maxAllowedContentLength="52428800"/>
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
